# ── Core ─────────────────────────────────────────────────────────────
# Local docker-compose Postgres (host port 5442) and Redis (host port 6380).
DATABASE_URL=postgresql://uptimekit:uptimekit@localhost:5442/uptimekit
REDIS_URL=redis://localhost:6380

# Public URL of the web app (used in emails and for auth origin checks).
APP_URL=http://localhost:3000

# ── Auth (Better Auth) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# ── Email ────────────────────────────────────────────────────────────
# EMAIL_PROVIDER=smtp | console
EMAIL_PROVIDER=smtp
EMAIL_FROM="UptimeKit <alerts@uptimekit.local>"
# Mailpit (dev mail capture). Web UI: http://localhost:8026
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Worker ───────────────────────────────────────────────────────────
WORKER_CONCURRENCY=20
WORKER_HEALTH_PORT=8081
SCHEDULER_TICK_MS=2000
CHECK_RETENTION_DAYS=30

# ── Monitor policy ───────────────────────────────────────────────────
MONITOR_MIN_INTERVAL_SECONDS=30
MAX_MONITORS_PER_USER=50

# DEVELOPMENT/TEST ONLY: comma-separated CIDRs the checker may reach despite SSRF rules
# (e.g. 127.0.0.1/32 to monitor a local test server). Never set this in production.
CHECKER_ALLOW_CIDRS=
